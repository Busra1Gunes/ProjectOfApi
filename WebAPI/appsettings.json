{
  //Bu kod, genellikle bir ASP.NET Core uygulamasının appsettings.json dosyasında kullanılan bir yapılandırmadır ve burada bir JSON Web Token (JWT) yapılandırmasını gösterir. 
  //Özellikle TokenOptions içinde JWT  token'ının oluşturulması için gerekli seçenekler yer almaktadır.
  "TokenOptions": {
    "Audience": "",
    "Issue": "",
    "AccessTokenExpiration": 10, // Token'in geçerlilik süresini dakikalar cinsinden belirler.
    "SecurityKey": "mysupersecretkey" //Token'in şifrelenmesi için kullanılan gizli anahtarı temsil eder. Bu anahtar, token'in güvenliğini sağlamak için kullanılır.

  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
